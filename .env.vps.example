# ==============================================================================
# .env.vps.example - conservative overrides for running the bot on a VPS
# ==============================================================================
#
# WHAT THIS FILE IS
#
# A drop-in .env that biases the trading path against latency-driven adverse
# selection. Every setting below is a documented knob from config.py; nothing
# here is a hidden feature. Compared to the code defaults, these settings
# cause the bot to REFUSE more marginal opportunities on a VPS. That trades
# a few missed fills for far fewer bad fills - which is the right direction
# on a host whose RTT to the venue is a few hundred milliseconds instead of
# tens.
#
# WHY THESE SETTINGS
#
# The recorded evidence in config.py:91-97 shows that T-60..T-0 lost 31.2%
# against a 69.6% break-even (z=-3.29) even from a fast home link. The
# mechanism is adverse selection: in the last stretch of a round the book
# goes one-sided and the fills still available are the ones the market is
# content to sell. That same selection pressure applies at any latency,
# but on a VPS the book you evaluate is a beat older, so the pressure is
# stronger against you.
#
# The overrides here narrow the entry envelope on a distant host so you
# only fill when the book was clearly good, not just probably good.
#
# BEFORE YOU USE THIS
#
#   1. Run `python vps_latency_check.py` on this host. If p50 to
#      clob.polymarket.com is above ~200 ms, this file will not save you;
#      move the VPS to a region closer to the venue first.
#   2. Copy this file to `.env`, then edit it with your credentials and
#      set `chmod 600 .env`. Credentials MUST NOT go into this template.
#   3. Run PAPER for at least a day and compare `paper_trade_log.csv`
#      against the same window from your home host before switching LIVE.
#
# You are choosing a more conservative operating point, not enabling a
# secret edge. Measure it.
#
# ==============================================================================

# ---- required credentials (fill in on the box, keep off the repo) ----
# POLY_PRIVATE_KEY=
# POLY_FUNDER=
# POLY_SIGNATURE_TYPE=1

# ---- entry envelope tightened ----

# Cap the buy at 0.85 instead of 0.90. On a slow link the fills that clear
# above 0.85 are structurally worse: the local players took the good ones
# before your submission arrived. Refuse rather than fill at a bad price.
MAX_BUY_PRICE=0.85

# Refuse a book that has been in our hands for more than 3 seconds
# (default 8 s). The default is generous for a home connection; on a VPS
# it lets a briefly stalled TCP path feed a dead snapshot into the
# decision. 3 s is still >>the healthy pooled RTT you should be seeing.
ORDERBOOK_MAX_AGE_SECONDS=3.0

# Give discovery and book-warm more headroom before the boundary, so a
# slower link does not eat into the trade window. Floor is 25 s.
ROUND_PREPARE_LEAD_SECONDS=45

# ---- keep the risk multiplier off ----

# Do not run multi-signal on a VPS. Every extra leg is another RTT roll
# of the dice; the second and third legs consistently pick up the worst
# side of whatever moved during the first leg's transit. Already off by
# default; documented here so an operator does not turn it on absent-
# mindedly on the slow host.
PHASE2_ENABLED=1
PHASE2_MULTI_SIGNAL=0
SIGNAL_MINORITY_RULE=0
PAPER_ALLOW_SIGNAL_FLIPS=0
LIVE_ALLOW_SIGNAL_FLIPS=0

# ---- keep the exits configured before enabling ----

# On PC you might have run without a stop; on a distant VPS the losses
# compound differently and a client-side stop is cheap insurance. Off by
# default; turn it on deliberately when you have measured the haircut.
# STOP_LOSS_ENABLED=1
# STOP_LOSS_PRICE=0.25
# STOP_LOSS_FLOOR_PRICE=0.19        # matches the measured inversion point
# STOP_LOSS_ARM_SECONDS=120
# STOP_LOSS_EXIT_CUTOFF_SECONDS=20

# Cheap-hedge defaults were widened this branch to cover single-leg
# rounds. If you find single legs on the VPS are consistently red, turn
# it on. Costs $0.30-1.00 of premium per fired round.
# CHEAP_HEDGE_ENABLED=1

# ---- non-strategy knobs ----

# Paper-mode balance for the first launch; ignored on subsequent starts
# once the paper account/ledger exist.
PAPER_START_BALANCE=1000

# Global cancel-all stays OFF. Only ever set both of these to 1 with a
# dedicated wallet that holds NO manual orders.
# CANCEL_OPEN_BEFORE_TRADE=0
# ALLOW_GLOBAL_CANCEL_ALL=0
